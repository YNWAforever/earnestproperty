{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "prettier": {
    "overrides": [
      {
        "files": "workers/mls-container/*.jsonc",
        "options": {
          "trailingComma": "none"
        }
      }
    ]
  },
