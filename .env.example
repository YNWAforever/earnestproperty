# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# --- Neon Auth ---
VITE_NEON_AUTH_URL=""
NEON_AUTH_BASE_URL=""
# Neon Auth organization used only for provider-managed staff invitations.
# This is an identifier, not a credential; leave blank until the provider organization is configured.
NEON_AUTH_ORGANIZATION_ID=""
# Staff sign-in binds a Neon Auth account to its staff_users row by VERIFIED
# email (src/lib/neon/auth.server.ts). Neon Auth does not verify emails unless
# "Verify at Sign-up" is enabled in the Neon console (project Settings -> Auth),
# so until it is, every invited member is refused after signing up and an admin
# must activate them with 連結帳戶 on the member's /admin/team detail panel.
# Password-reset and verification emails come from auth@mail.myneon.app and
# only redirect to origins listed under Neon Console -> Auth -> Configuration
# -> Domains, so the production origin (SITE_URL in src/content/seo.ts) must
# be on that list; reset links expire after 15 minutes.

# --- WhatsApp / phone CTAs (src/config/site.ts) ---
# Every generic "WhatsApp" button site-wide (header, mobile menu, homepage
# 我要買樓/我要租樓/我要放盤估價, estate pages, the /contact page's own WhatsApp
# button) builds its link from VITE_CONTACT_WHATSAPP_PHONE. Leaving it unset
# does NOT crash the app -- whatsappUrl() falls back to a plain "/contact"
# link -- but it silently breaks every one of those CTAs. `npm run build`
# fails on Vercel (production/preview) if these are missing; see
# scripts/check-required-env.mjs.
#
# Must be a real WhatsApp-capable mobile number. The three branch numbers in
# src/config/site-branches.js (26882988 / 26886996 / 26882883) are landlines
# and cannot receive WhatsApp messages -- do not use them here.
# --- Production origin (scripts/site-origin.mjs, src/content/seo.ts) ---
# Every canonical link, sitemap <loc>, robots.txt Sitemap line, og:image and
# JSON-LD url is built from this. Normally leave it UNSET: on Vercel the build
# resolves the origin from VERCEL_PROJECT_PRODUCTION_URL, which is the
# project's production host today (https://earnestproperty.vercel.app) and
# becomes the custom domain automatically once one is attached in Vercel ->
# Project -> Domains. Set this only to force a different origin. In production
# builds only (VERCEL_ENV=production), when the resolved origin is an https host
# that is not a vercel.app host, vercel.ts 308s pages on
# earnestproperty.vercel.app to the same path on it. /api, /api/*, /_serverFn/*,
# /w/*, /assets/* and /.well-known/* are never host-redirected, and preview builds never
# redirect. Local dev and tests fall back to the vercel.app host. The origin
# must also be listed under Neon Console -> Auth -> Configuration -> Domains
# (see VITE_NEON_AUTH_URL above).
# VITE_SITE_URL=""

VITE_CONTACT_WHATSAPP_PHONE="85200000000"
# Human-readable phone shown in the UI, e.g. contact page 總機 row.
VITE_CONTACT_PHONE_DISPLAY="2688 2988"
# tel: link target, digits only after the leading +.
VITE_CONTACT_PHONE_TEL="+85226882988"

# --- WhatsApp integration (Woztell) ---
# Master switch for SENDING. Leave "false" until every credential below is set:
# flipping it with partial credentials turns the admin badge green while each
# send fails and every inbound webhook is silently rejected.
WOZTELL_ENABLED="false"
# Channel id from Channels -> Channel Info in the Woztell console.
WOZTELL_CHANNEL_ID=""
# Channel secret from the same panel. Used ONLY to verify the HMAC-SHA256
# signature on inbound webhooks -- it is not an API credential. While it is
# unset every inbound message is rejected and never reaches the inbox.
WOZTELL_CHANNEL_SECRET=""
# Access token for the Bot API (bot.api.woztell.com/sendResponses), which is how
# replies and campaign blasts go out. Needs scope bot:sendResponses or bot:admin.
WOZTELL_BOT_ACCESS_TOKEN=""
# A SECOND, separately-scoped access token -- NOT the same value as above.
# Reading conversation history goes to a different host (open.api.woztell.com/v3)
# and accepts only conversation:read / member:getConversation / api:admin. The
# bot token carries none of those, so reusing it fails with "User is not
# authenticated." Generate at Settings -> Access Tokens with api:admin.
# Only needed to run POST /api/admin/woztell/backfill, which imports messages
# that predate this webhook being switched on.
WOZTELL_OPEN_API_TOKEN=""

# --- Admin bootstrap / owner accounts ---
# Comma-separated emails allowed to become the first admin when staff_users is
# empty. These accounts are ALSO protected: their admin role cannot be removed
# and they cannot be deactivated from the admin UI, so the owner cannot be
# locked out. Unset disables first-login bootstrap entirely (403 until staff are
# seeded out-of-band) and leaves no account protected.
# Only provider-verified identities with the same account ID and email can bootstrap.
# Set the intended owner email explicitly; an empty value disables bootstrap.
# Existing bound staff or assigned roles block bootstrap. Disabled profiles cannot bootstrap.
# Recovery: another authorized admin links/repairs staff identity; if none exists,
# use an explicitly approved database recovery operation after proving ownership.
# Do not reset staff tables or disable verification to recover access.
ADMIN_BOOTSTRAP_EMAILS=""

# --- Cloudflare Container dual-source MLS synchronization ---
# Neon dashboard -> direct/unpooled connection string for the Container only.
DATABASE_URL_UNPOOLED=""
# Vercel Blob project store -> read/write token; required only for publish uploads.
BLOB_READ_WRITE_TOKEN=""
# Public operator/contact page included in the honest crawler user agent.
MLS_CRAWLER_CONTACT_URL=""
# Double publication gate. Keep false through all shadow runs.
MLS_PUBLISH_ENABLED="false"
# Operator attestation that 28Hse listing photos are Earnest-owned/authorized.
MLS_MEDIA_RIGHTS_CONFIRMED="false"
# Comma-separated exact HTTPS media hostnames reviewed for outbound access.
# This network allowlist does not grant content rights.
MLS_MEDIA_ALLOWED_HOSTS=""
# Enable only after the media_asset_variants migration and staging backfill check.
# Uses already authorized owned MLS image bytes; public pages retain original URLs on failure.
MLS_MEDIA_VARIANTS_ENABLED="false"
# Exact owned Vercel Blob hostnames for the isolated backfill reader, not source-site hosts.
MLS_OWNED_BLOB_HOSTS=""
# The backfill apply path requires this explicit staging marker; dry-run remains read-only.
MEDIA_BACKFILL_TARGET=""
# Local filesystem compatibility only. Container runs select R2 explicitly.
MLS_ARTIFACT_DIR="artifacts/mls-sync"
# Select `r2` only in the Container; leave unset for local filesystem evidence.
MLS_EVIDENCE_BACKEND=""
# Non-secret Container run identity. Required when MLS_EVIDENCE_BACKEND="r2".
MLS_ENVIRONMENT=""
MLS_SCHEDULED_FOR=""
MLS_ATTEMPT_ID=""
MLS_COMMIT_SHA=""
CLOUDFLARE_DEPLOYMENT_ID=""
MLS_WORKFLOW_INSTANCE_ID=""
MLS_CONTAINER_ID=""
MLS_ATTEMPT_STARTED_AT=""
MLS_TERMINAL_STATUS_FILE=""
# Private R2 evidence configuration. Never place real credential values here.
CLOUDFLARE_ACCOUNT_ID=""
MLS_EVIDENCE_BUCKET=""
MLS_R2_ACCESS_KEY_ID=""
MLS_R2_SECRET_ACCESS_KEY=""

# --- YouTube official-channel synchronization ---
# Google Cloud Console -> APIs & Services -> Credentials. The owning project
# must have YouTube Data API v3 enabled. Server-only; never prefix with VITE_.
YOUTUBE_API_KEY=""
# Manual protected GET routes reuse the existing CRON_SECRET bearer convention.
# The fixed channel ID lives in youtube-sync.types.ts and is not a secret.

# --- AI Gateway (CRM lead analysis) ---
# AI Gateway: admin CRM lead analysis only. Unset = CRM analysis stores the
# rule-based fallback.
# Vercel AI Gateway (https://ai-gateway.vercel.sh/v1), called directly via
# fetch in src/lib/ai/provider.server.ts -- not the Vercel AI SDK. The public
# live-agent widget makes no model call (FX-11, D1 = a), and the knowledge
# index stores no embeddings (FX-11a). Unset never crashes -- see
# getAiServerConfig()'s `enabled` flag.
AI_GATEWAY_API_KEY=""
# A plain "provider/model" string passed straight through to the gateway,
# e.g. "anthropic/claude-sonnet-5" -- no model name is hardcoded in code.
AI_GATEWAY_MODEL=""

# --- opencode-go (admin CMS content copilot) ---
# A SEPARATE provider from the AI Gateway above -- do not assume they share
# credentials. Caller-supplied endpoint, not a fixed URL. Powers the admin
# CMS's AI writing assistant for estate/article copy
# (src/lib/ai/content-copilot.server.ts). Requires all three set; unset
# disables the content copilot, no crash.
OPENCODE_GO_BASE_URL=""
OPENCODE_GO_API_KEY=""
OPENCODE_GO_MODEL=""

# --- Tavily (optional web-search grounding for the content copilot) ---
# Lets generated estate/article copy cite current search results instead of
# only the model's own (possibly stale) knowledge. Optional -- the content
# copilot still works without it, just without live-web grounding.
TAVILY_API_KEY=""

# --- Control plane two-person approval ---
# Gates an approval step in src/lib/control-plane/ (jobs/migrations/audit).
# Not further documented here -- see that directory's own code for exactly
# which actions require it.
CONTROL_PLANE_APPROVAL_SECRET=""

# GA4 web stream; leave disabled until Enhanced Measurement automatic events are disabled.
VITE_GA4_MEASUREMENT_ID=""
VITE_GA4_MANUAL_EVENTS_CONFIRMED="false"

# No-Hermes snapshot receiver (publishing also requires approved DB policy; disabled by default).
# Generate independently in the operator secret store; never reuse a browser/session token.
PROPERTYHK_SYNC_SECRET=
PROPERTYHK_SYNC_URL=https://www.earnestproperty.com/api/admin/propertyhk-sync
PROPERTYHK_SYNC_MAX_BYTES=5242880
# Python worker must separately allow the exact HTTPS submission origin in deployment config.

# WhatsApp enquiry Phase 1 (server-only, default off; see release runbook).
# Observation requires verified channel/app identity and the additive event migration.
WOZTELL_APP_ID=""
EP_WA_ENQUIRY_MODE="off"
# Company placement configuration: verify independently before enabling links.
EP_WA_COMPANY_CHANNEL_ID=""
EP_WA_COMPANY_PHONE=""
# Live routing remains blocked pending tenant execution/readback verification.
EP_WA_TRACKED_LINKS_ENABLED="false"
# Fixed 32 global shards; 5000/min/shard safety cap. Registered links also get a separate 600/min cap.
# Change only after isolated staging load evidence; values appear in WhatsApp service health.
EP_WA_REDIRECT_GLOBAL_SHARD_PER_MIN="5000"
EP_WA_REDIRECT_LINK_PER_MIN="600"
EP_WA_ROUTING_ENABLED="false"
EP_WA_SERVICE_AUTOMATION_ENABLED="false"
# Persisted approved activation generation; leave empty until separately approved release.
EP_WA_ACTIVATION_ID=""

# Staff handoff remains independently disabled until recipient/tenant/policy approval.
EP_WA_STAFF_NOTIFICATIONS_ENABLED="false"
# Server-only. Approved WozTell staff template as JSON {name,language,params}; empty = alerts blocked (模板未設定).
EP_WA_STAFF_ALERT_TEMPLATE=

# Staff handoff provider capabilities: empty means unverified; never copy fixture values.
# Server-only tenant evidence and exact validated Inbox endpoints.
EP_WA_INBOX_VERIFICATION_REF=
EP_WA_INBOX_INTEGRATION_ID=
EP_WA_INBOX_SIGNATURE=
EP_WA_INBOX_LIST_THREADS_URL=
EP_WA_INBOX_LIST_USERS_URL=
EP_WA_INBOX_ASSIGN_URL=
EP_WA_INBOX_INTERNAL_MESSAGE_URL=
# Separate optional staff WhatsApp transport and signed reply correlation evidence.
EP_WA_STAFF_WHATSAPP_VERIFICATION_REF=
EP_WA_STAFF_CORRELATION_VERIFICATION_REF=
EP_WA_STAFF_REPLY_CONTEXT_PATH=
EP_WA_STAFF_ASSOCIATION_REVIEW_REF=

# Before setting in production, run the pre-flight in docs/audits/fx-plans/FX-07-jobs-drain.md (setting it starts draining the backlog on the next committed job).
# Origin of the job alarm Worker (https://…workers.dev). Set = post-commit wakes on; empty = no wake (the Worker's cron sweep still drains: every 10 minutes 08:00-22:00 HKT, hourly overnight). No database URL here. While this is blank, health shows 降級 (未設定即時喚醒).
OPS_WAKE_URL=
# Server-only bearer shared with the job alarm Worker secret of the same name.
CRON_SECRET=

# Source synchronization admin operations; server-only, off until isolated migration + release gates.
PROPERTY_SYNC_OBSERVABILITY_ENABLED=false
PROPERTY_SYNC_ADMIN_DISPATCH_ENABLED=false
PROPERTY_SYNC_WORKFLOW_TOKEN=
PROPERTY_SYNC_WITHDRAWAL_REVIEW_ENABLED=false

# Operator-only migration target and explicit approval; never enabled by the dashboard.
PROPERTY_SYNC_EXPECTED_DATABASE_BRANCH=
PROPERTY_SYNC_MIGRATION_APPROVED=false
